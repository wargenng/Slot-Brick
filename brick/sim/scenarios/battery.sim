# The normal event loop drives the warning, including with decorative LEDs off.
press a
phase Shelf
set battery 16
wait 10500
led effect_f1 4
set battery 15
wait 10500
led effect_rgb_hex_f1 FF0000
led effect_rgb_hex_f2 FF0000
led effect_f1 5
led effect_f2 5
led max_scale_f1f2 20
led effect_rgb_hex_m FFFFFF
down select
press b
up select
led max_scale 0
led max_scale_lr 0
led max_scale_f1f2 20
led effect_f1 5
set charging 1
wait 1500
led max_scale_f1f2 0
led effect_f1 4
set charging 0
wait 1500
led effect_f1 5
led max_scale_f1f2 20
press power
phase Doze
led effect_enable 0
led max_scale_f1f2 0
set charging 1
wait 1500
led effect_enable 0
press power
phase Shelf
wait 1500
led effect_f1 4
led max_scale_f1f2 0
